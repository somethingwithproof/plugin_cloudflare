msgid "Token file is missing or insecure"
msgstr "토큰 파일이 없거나 안전하지 않습니다"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "암호화된 저장소를 사용할 수 없습니다. 키 파일을 구성하거나 토큰 파일을 사용하세요"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "32자리 16진수 Cloudflare 계정 ID를 입력하세요"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "제어 문자를 제외하고 1~100자의 이름을 입력하세요"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "암호화된 토큰 또는 토큰 파일을 선택하세요"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "API 토큰을 입력하세요"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "계정 ID를 변경할 때 토큰을 다시 입력하세요"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "최대 255자의 절대 경로를 입력하세요"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "0 또는 1이어야 합니다"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "60에서 86400 사이의 정수(초)를 입력하세요"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "이 Cloudflare 계정 ID는 이미 구성되어 있습니다"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Global API Key는 허용되지 않습니다. 범위가 지정된 API 토큰을 사용하세요"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "API 토큰 형식이 올바르지 않습니다"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "토큰 볼트 키 파일이 없거나, 읽을 수 없거나, 안전하지 않거나, 형식이 잘못되었습니다"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "저장된 API 토큰을 복호화할 수 없습니다"

