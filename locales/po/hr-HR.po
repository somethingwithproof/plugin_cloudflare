msgstr[1] "Kliknite 'Nastavi' kako biste omogućili sljedeće Cloudflare račune."
msgstr[2] "Kliknite 'Nastavi' kako biste omogućili sljedeće Cloudflare račune."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Kliknite 'Nastavi' kako biste onemogućili sljedeći Cloudflare račun."
msgstr[1] "Kliknite 'Nastavi' kako biste onemogućili sljedeće Cloudflare račune."
msgstr[2] "Kliknite 'Nastavi' kako biste onemogućili sljedeće Cloudflare račune."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Kliknite 'Nastavi' za izradu Cacti uređaja za sljedeći Cloudflare račun. Račun koji ga već ima ostaje nepromijenjen."
msgstr[1] "Kliknite 'Nastavi' za izradu Cacti uređaja za svaki od sljedećih Cloudflare računa. Račun koji ga već ima ostaje nepromijenjen."
msgstr[2] "Kliknite 'Nastavi' za izradu Cacti uređaja za svaki od sljedećih Cloudflare računa. Račun koji ga već ima ostaje nepromijenjen."

