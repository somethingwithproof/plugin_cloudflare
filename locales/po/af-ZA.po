msgstr[1] "Klik 'Gaan voort' om die volgende Cloudflare-rekeninge te skrap. Hul ontdekte voorraad en werkstatus word verwyder; Cacti-toestelle en -grafieke word behou."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Klik 'Gaan voort' om die volgende Cloudflare-rekening teen die Cloudflare API te verifieer."
msgstr[1] "Klik 'Gaan voort' om die volgende Cloudflare-rekeninge teen die Cloudflare API te verifieer."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Klik 'Gaan voort' om die volgende Cloudflare-rekening te aktiveer."
msgstr[1] "Klik 'Gaan voort' om die volgende Cloudflare-rekeninge te aktiveer."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Klik 'Gaan voort' om die volgende Cloudflare-rekening te deaktiveer."
msgstr[1] "Klik 'Gaan voort' om die volgende Cloudflare-rekeninge te deaktiveer."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Klik 'Gaan voort' om 'n Cacti-toestel vir die volgende Cloudflare-rekening te skep. 'n Rekening wat reeds een het, word gelaat soos dit is."
msgstr[1] "Klik 'Gaan voort' om 'n Cacti-toestel vir elk van die volgende Cloudflare-rekeninge te skep. 'n Rekening wat reeds een het, word gelaat soos dit is."

