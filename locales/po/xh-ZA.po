#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Cofa u-'Qhubeka' ukuze uCime le Akhawunti ye-Cloudflare ilandelayo. Uluhlu lwayo olufunyenweyo kunye nemeko yomsebenzi ziyasuswa; izixhobo ze-Cacti neegrafu ziyagcinwa."
msgstr[1] "Cofa u-'Qhubeka' ukuze uCime ezi Akhawunti ze-Cloudflare zilandelayo. Uluhlu lwazo olufunyenweyo kunye nemeko yomsebenzi ziyasuswa; izixhobo ze-Cacti neegrafu ziyagcinwa."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Cofa u-'Qhubeka' ukuze uQinisekise le Akhawunti ye-Cloudflare ilandelayo kwi-Cloudflare API."
msgstr[1] "Cofa u-'Qhubeka' ukuze uQinisekise ezi Akhawunti ze-Cloudflare zilandelayo kwi-Cloudflare API."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Cofa u-'Qhubeka' ukuze uYenze isebenze le Akhawunti ye-Cloudflare ilandelayo."
msgstr[1] "Cofa u-'Qhubeka' ukuze uZenze zisebenze ezi Akhawunti ze-Cloudflare zilandelayo."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Cofa u-'Qhubeka' ukuze uKhubaze le Akhawunti ye-Cloudflare ilandelayo."
msgstr[1] "Cofa u-'Qhubeka' ukuze uZikhubaze ezi Akhawunti ze-Cloudflare zilandelayo."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Cofa u-'Qhubeka' ukuze wenze isixhobo se-Cacti sale Akhawunti ye-Cloudflare ilandelayo. Iakhawunti esele inaso ishiywa injalo."
msgstr[1] "Cofa u-'Qhubeka' ukuze wenze isixhobo se-Cacti se-Akhawunti ye-Cloudflare nganye kwezi zilandelayo. Iakhawunti esele inaso ishiywa injalo."

