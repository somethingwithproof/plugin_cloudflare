msgstr "Kitambulisho hiki cha akaunti ya Cloudflare tayari kimesanidiwa"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Vifunguo vya Global API Keys havikubaliwi; tumia tokeni ya API yenye wigo maalumu"

