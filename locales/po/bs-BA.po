msgstr[1] "Kliknite 'Nastavi' da omogućite sljedeće Cloudflare naloge."
msgstr[2] "Kliknite 'Nastavi' da omogućite sljedeće Cloudflare naloge."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
