msgstr[1] "Kliknite 'Nastavi' da onemogućite sljedeće Cloudflare naloge."
msgstr[2] "Kliknite 'Nastavi' da onemogućite sljedeće Cloudflare naloge."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Kliknite 'Nastavi' da kreirate Cacti uređaj za sljedeći Cloudflare nalog. Nalog koji ga već ima ostaje kakav jeste."
msgstr[1] "Kliknite 'Nastavi' da kreirate Cacti uređaj za svaki od sljedećih Cloudflare naloga. Nalog koji ga već ima ostaje kakav jeste."
msgstr[2] "Kliknite 'Nastavi' da kreirate Cacti uređaj za svaki od sljedećih Cloudflare naloga. Nalog koji ga već ima ostaje kakav jeste."

