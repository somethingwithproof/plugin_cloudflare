msgid "API token format is invalid"
msgstr "Формат API токена није исправан"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "Датотека кључа трезора токена недостаје, нечитљива је, небезбедна или неисправног формата"

