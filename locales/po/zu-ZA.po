msgstr[0] "Chofoza u-'Qhubeka' ukuze Ususe le Akhawunti ye-Cloudflare elandelayo. Uhlu lwayo lwezinsiza ezitholakele nesimo somsebenzi kuyasuswa; amadivayisi e-Cacti namagrafu kuyagcinwa."
msgstr[1] "Chofoza u-'Qhubeka' ukuze Ususe la Ma-akhawunti e-Cloudflare alandelayo. Uhlu lwawo lwezinsiza ezitholakele nesimo somsebenzi kuyasuswa; amadivayisi e-Cacti namagrafu kuyagcinwa."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Chofoza u-'Qhubeka' ukuze Uqinisekise le Akhawunti ye-Cloudflare elandelayo ku-Cloudflare API."
msgstr[1] "Chofoza u-'Qhubeka' ukuze Uqinisekise la Ma-akhawunti e-Cloudflare alandelayo ku-Cloudflare API."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Chofoza u-'Qhubeka' ukuze Unike amandla le Akhawunti ye-Cloudflare elandelayo."
msgstr[1] "Chofoza u-'Qhubeka' ukuze Unike amandla la Ma-akhawunti e-Cloudflare alandelayo."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Chofoza u-'Qhubeka' ukuze Ukhubaze le Akhawunti ye-Cloudflare elandelayo."
msgstr[1] "Chofoza u-'Qhubeka' ukuze Ukhubaze la Ma-akhawunti e-Cloudflare alandelayo."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Chofoza u-'Qhubeka' ukuze udale idivayisi ye-Cacti yale Akhawunti ye-Cloudflare elandelayo. I-akhawunti esivele inayo ishiywa injalo."
msgstr[1] "Chofoza u-'Qhubeka' ukuze udale idivayisi ye-Cacti ye-akhawunti ngayinye kula Ma-akhawunti e-Cloudflare alandelayo. I-akhawunti esivele inayo ishiywa injalo."

