msgid "The Cloudflare account no longer exists."
msgstr "Cloudflare акаунтът вече не съществува."

#: includes/accounts_page.php
msgid "The Cloudflare accounts could not be read. See the Cacti log for details."
msgstr "Cloudflare акаунтите не можаха да бъдат прочетени. Вижте журнала на Cacti за подробности."

#: includes/accounts_page.php
msgid "Create Graphs was left off: turning it on needs the permission to edit Cacti devices."
msgstr "„Създаване на графики“ беше оставено изключено: включването му изисква право за редактиране на устройства в Cacti."

#: includes/accounts_page.php
msgid "Cacti device created"
msgstr "Устройството в Cacti е създадено"

#: includes/accounts_page.php
msgid "A Cacti device already exists for this account"
msgstr "За този акаунт вече съществува устройство в Cacti"

#: includes/accounts_page.php
msgid "The Cloudflare templates are not installed; see the Cacti log"
msgstr "Шаблоните на Cloudflare не са инсталирани; вижте журнала на Cacti"

#: includes/accounts_page.php
msgid "You are not permitted to create Cacti devices"
msgstr "Нямате права да създавате устройства в Cacti"

#: includes/accounts_page.php
msgid "The Cacti device could not be created; see the Cacti log"
msgstr "Устройството в Cacti не можа да бъде създадено; вижте журнала на Cacti"

#: includes/accounts_page.php
msgid "You are not permitted to create Cacti devices."
msgstr "Нямате права да създавате устройства в Cacti."

#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Натиснете „Продължи“, за да изтриете следния Cloudflare акаунт. Откритият му инвентар и състоянието на задачите ще бъдат премахнати; устройствата и графиките в Cacti се запазват."
msgstr[1] "Натиснете „Продължи“, за да изтриете следните Cloudflare акаунти. Откритият им инвентар и състоянието на задачите ще бъдат премахнати; устройствата и графиките в Cacti се запазват."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Натиснете „Продължи“, за да проверите следния Cloudflare акаунт спрямо Cloudflare API."
msgstr[1] "Натиснете „Продължи“, за да проверите следните Cloudflare акаунти спрямо Cloudflare API."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Натиснете „Продължи“, за да включите следния Cloudflare акаунт."
msgstr[1] "Натиснете „Продължи“, за да включите следните Cloudflare акаунти."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Натиснете „Продължи“, за да изключите следния Cloudflare акаунт."
msgstr[1] "Натиснете „Продължи“, за да изключите следните Cloudflare акаунти."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Натиснете „Продължи“, за да създадете устройство в Cacti за следния Cloudflare акаунт. Акаунт, който вече има устройство, се оставя без промяна."
msgstr[1] "Натиснете „Продължи“, за да създадете устройство в Cacti за всеки от следните Cloudflare акаунти. Акаунт, който вече има устройство, се оставя без промяна."

