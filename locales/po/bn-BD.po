#: cloudflare_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "পর্যবেক্ষণগুলো পড়া যায়নি। প্লাগইন লগ পরীক্ষা করতে একজন প্রশাসককে বলুন।"

#: includes/accounts.php
msgid "Connection verified"
msgstr "সংযোগ যাচাইকৃত"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "টোকেনটি সক্রিয় নয়; এটি মেয়াদোত্তীর্ণ বা নিষ্ক্রিয় হতে পারে"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "টোকেনটি অবৈধ বা মেয়াদোত্তীর্ণ"

#: includes/accounts.php
