msgid "Cloudflare API is unreachable; try again later"
msgstr "Cloudflare API تک رسائی ممکن نہیں؛ بعد میں دوبارہ کوشش کریں"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Cloudflare API کی شرح کی حد پوری ہو گئی؛ بعد میں دوبارہ کوشش کریں"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Cloudflare API کی درخواست غیر متوقع طور پر ناکام ہو گئی"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "ٹوکن کے پاس اس کی تصدیق کے لیے درکار اجازتیں نہیں ہیں"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "محفوظ شدہ ٹوکن کو ڈکرپٹ نہیں کیا جا سکتا"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "ٹوکن والٹ کلید کی فائل غائب ہے یا ناقابلِ استعمال ہے"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "ٹوکن فائل غائب ہے یا غیر محفوظ ہے"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "انکرپٹڈ اسٹوریج دستیاب نہیں ہے؛ کلید کی فائل کنفیگر کریں یا ٹوکن فائل استعمال کریں"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "32 حروف پر مشتمل ہیکسا ڈیسیمل Cloudflare اکاؤنٹ ID درج کریں"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "کنٹرول کریکٹرز کے بغیر 1 سے 100 حروف کا نام درج کریں"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "انکرپٹڈ ٹوکن یا ٹوکن فائل منتخب کریں"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "API ٹوکن درج کریں"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "اکاؤنٹ ID تبدیل کرتے وقت ٹوکن دوبارہ درج کریں"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "زیادہ سے زیادہ 255 حروف کا مکمل راستہ درج کریں"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "0 یا 1 ہونا ضروری ہے"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "60 سے 86400 تک سیکنڈز کا مکمل عدد درج کریں"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "یہ Cloudflare اکاؤنٹ ID پہلے سے ترتیب دی گئی ہے"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Global API Keys قبول نہیں کی جاتیں؛ محدود دائرہ اختیار والا API ٹوکن استعمال کریں"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "API ٹوکن کا فارمیٹ غلط ہے"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "ٹوکن والٹ کلیدی فائل غائب، ناقابلِ مطالعہ، غیر محفوظ یا خراب فارمیٹ میں ہے"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "محفوظ کردہ API ٹوکن کو ڈکرپٹ نہیں کیا جا سکا"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "ٹوکن فائل غائب، ناقابلِ مطالعہ، باقاعدہ فائل نہیں یا بہت بڑی ہے"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "ٹوکن فائل کا راستہ مطلق (absolute) نہیں ہے، یہ symlink ہے، یا فائل سب کے لیے قابلِ مطالعہ یا قابلِ تحریر ہے"

