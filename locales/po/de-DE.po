#: includes/accounts.php
msgid "Connection verified"
msgstr "Verbindung überprüft"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "Das Token ist nicht aktiv; es ist möglicherweise abgelaufen oder deaktiviert"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "Das Token ist ungültig oder abgelaufen"

#: includes/accounts.php
msgid "Token lacks the Account Cloudflare Tunnel Read permission"
msgstr "Dem Token fehlt die Berechtigung „Account Cloudflare Tunnel Read“"

#: includes/accounts.php
msgid "Cloudflare API is unreachable; try again later"
msgstr "Die Cloudflare-API ist nicht erreichbar; versuchen Sie es später erneut"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Das Anfragelimit der Cloudflare-API ist erreicht; versuchen Sie es später erneut"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Die Cloudflare-API-Anfrage ist unerwartet fehlgeschlagen"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "Dem Token fehlen die Berechtigungen, um es zu überprüfen"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "Das gespeicherte Token kann nicht entschlüsselt werden"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "Die Schlüsseldatei des Token-Tresors fehlt oder ist unbrauchbar"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "Die Token-Datei fehlt oder ist unsicher"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "Der verschlüsselte Speicher ist nicht verfügbar; richten Sie die Schlüsseldatei ein oder verwenden Sie eine Token-Datei"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "Geben Sie die 32-stellige hexadezimale Cloudflare-Konto-ID ein"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "Geben Sie einen Namen mit 1 bis 100 Zeichen ohne Steuerzeichen ein"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "Wählen Sie ein verschlüsseltes Token oder eine Token-Datei"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "Geben Sie ein API-Token ein"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "Geben Sie das Token erneut ein, wenn Sie die Konto-ID ändern"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "Geben Sie einen absoluten Pfad mit höchstens 255 Zeichen ein"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "Muss 0 oder 1 sein"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "Geben Sie eine ganze Zahl von Sekunden zwischen 60 und 86400 ein"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "Diese Cloudflare-Konto-ID ist bereits eingerichtet"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Globale API-Schlüssel werden nicht akzeptiert; verwenden Sie ein API-Token mit eingeschränktem Geltungsbereich"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "Das Format des API-Tokens ist ungültig"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "Die Schlüsseldatei des Token-Tresors fehlt, ist nicht lesbar, unsicher oder fehlerhaft aufgebaut"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "Das gespeicherte API-Token konnte nicht entschlüsselt werden"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "Die Token-Datei fehlt, ist nicht lesbar, keine reguläre Datei oder zu groß"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Der Pfad der Token-Datei ist nicht absolut oder ein symbolischer Link, oder die Datei ist für alle lesbar oder beschreibbar"

#: includes/accounts.php
msgid "API token could not be encrypted"
msgstr "Das API-Token konnte nicht verschlüsselt werden"

#: includes/accounts.php
msgid "Credential error"
msgstr "Fehler bei den Zugangsdaten"

#: includes/accounts.php includes/settings.php
msgid "Cloudflare"
msgstr "Cloudflare"

#: includes/accounts.php
msgid "Encrypted in the Cacti database"
msgstr "In der Cacti-Datenbank verschlüsselt"

