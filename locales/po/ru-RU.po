msgid "Cloudflare"
msgstr "Cloudflare"

#: includes/accounts.php
msgid "Encrypted in the Cacti database"
msgstr "В зашифрованном виде в базе данных Cacti"

#: includes/accounts.php
msgid "Token file on this server"
msgstr "Файл токена на этом сервере"

