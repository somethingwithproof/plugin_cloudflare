msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Đường dẫn tệp mã thông báo không phải đường dẫn tuyệt đối, là liên kết tượng trưng (symlink), hoặc tệp có quyền đọc/ghi cho mọi người dùng"

#: includes/accounts.php
