msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Njia ya faili ya tokeni si kamili, ni kiungo cha mfumo (symlink), au faili inaweza kusomwa au kuandikwa na mtu yeyote"

