msgstr[1] "Cloudflare API کے مقابلے میں درج ذیل Cloudflare اکاؤنٹس کی تصدیق کرنے کے لیے 'جاری رکھیں' پر کلک کریں۔"

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "درج ذیل Cloudflare اکاؤنٹ کو فعال کرنے کے لیے 'جاری رکھیں' پر کلک کریں۔"
msgstr[1] "درج ذیل Cloudflare اکاؤنٹس کو فعال کرنے کے لیے 'جاری رکھیں' پر کلک کریں۔"

#: includes/accounts_page.php
