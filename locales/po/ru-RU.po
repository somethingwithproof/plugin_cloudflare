msgstr "Имя"

#: includes/accounts.php
msgid "A label for this account in Cacti."
msgstr "Метка для этой учётной записи в Cacti."

#: includes/accounts.php includes/accounts_page.php
msgid "Account ID"
msgstr "ID учётной записи"

#: includes/accounts.php
msgid "The 32-character Cloudflare account ID, shown in the dashboard URL and on the account overview page."
msgstr "32-символьный ID учётной записи Cloudflare, отображаемый в URL панели управления и на странице обзора учётной записи."

#: includes/accounts.php
msgid "API Token"
msgstr "Токен API"

#: includes/accounts.php
msgid "Token Storage"
msgstr "Хранилище токена"

#: includes/accounts.php
msgid "Where the scoped API token is kept. Global API Keys are not accepted."
msgstr "Где хранится токен API с ограниченными правами. Глобальные ключи API не принимаются."

#: includes/accounts.php
msgid "Encrypted storage is unavailable because the key file in Settings is missing or unusable; only token files can be used."
msgstr "Зашифрованное хранилище недоступно, так как файл ключа в настройках отсутствует или непригоден для использования; можно использовать только файлы токенов."

#: includes/accounts.php
msgid "Leave blank to keep the current token"
msgstr "Оставьте пустым, чтобы сохранить текущий токен"

#: includes/accounts.php
msgid "A scoped API token with Account Cloudflare Tunnel Read permission."
msgstr "Токен API с ограниченными правами и разрешением «Account Cloudflare Tunnel Read»."

#: includes/accounts.php
msgid "Token File"
msgstr "Файл токена"

#: includes/accounts.php
msgid "Absolute path to a file that contains only the token. It must be readable by the web server and poller users and must not be world-readable."
msgstr "Абсолютный путь к файлу, содержащему только токен. Он должен быть доступен для чтения пользователям веб-сервера и поллера и не должен быть доступен для чтения всем пользователям."

#: includes/accounts.php
msgid "Collection"
msgstr "Сбор данных"

#: includes/accounts.php includes/accounts_page.php
msgid "Enabled"
msgstr "Включено"

#: includes/accounts.php
msgid "Disabled accounts are not polled."
msgstr "Отключённые учётные записи не опрашиваются."

#: includes/accounts.php
msgid "Collect Tunnels"
msgstr "Собирать данные туннелей"

#: includes/accounts.php
msgid "Discover Cloudflare Tunnels and their connectors."
msgstr "Обнаруживать туннели Cloudflare и их коннекторы."

#: includes/accounts.php
msgid "Collect Analytics"
msgstr "Собирать аналитику"

#: includes/accounts.php
msgid "Collect zone traffic analytics. This needs the Account Analytics Read and Analytics Read (Zone) permissions."
msgstr "Собирать аналитику трафика зон. Для этого требуются разрешения «Account Analytics Read» и «Analytics Read (Zone)»."

#: includes/accounts.php
msgid "Create Graphs"
msgstr "Создавать графики"

#: includes/accounts.php
msgid "Create graphs for each tunnel on the account's Cacti device. Turning this on needs the permission to edit Cacti devices."
msgstr "Создавать графики для каждого туннеля на устройстве Cacti этой учётной записи. Для включения требуется разрешение на редактирование устройств Cacti."

#: includes/accounts.php
msgid "Discovery Interval"
msgstr "Интервал обнаружения"

#: includes/accounts.php
msgid "Seconds between inventory refreshes, from 60 to 86400."
msgstr "Интервал в секундах между обновлениями инвентаризации, от 60 до 86400."

#: includes/accounts.php
msgid "The token and its confirmation do not match"
msgstr "Токен и его подтверждение не совпадают"

#: includes/accounts_page.php
msgid "Delete"
msgstr "Удалить"

#: includes/accounts_page.php
msgid "Verify"
msgstr "Проверить"

#: includes/accounts_page.php
msgid "Enable"
msgstr "Включить"

#: includes/accounts_page.php
