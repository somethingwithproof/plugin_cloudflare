#: cloudflare_operator.php
msgid "Monitoring view"
msgstr "Изглед за наблюдение"

#: cloudflare_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Наблюденията не можаха да бъдат прочетени. Помолете администратор да провери журнала на плъгина."

#: includes/accounts.php
msgid "Connection verified"
msgstr "Връзката е проверена"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "Токенът не е активен; може да е изтекъл или деактивиран"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "Токенът е невалиден или изтекъл"

#: includes/accounts.php
msgid "Token lacks the Account Cloudflare Tunnel Read permission"
msgstr "Токенът няма правото Account Cloudflare Tunnel Read"

#: includes/accounts.php
msgid "Cloudflare API is unreachable; try again later"
msgstr "Cloudflare API е недостъпен; опитайте отново по-късно"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Достигнат е лимитът за заявки на Cloudflare API; опитайте отново по-късно"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Заявката към Cloudflare API се провали неочаквано"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "Токенът няма правата, необходими за проверката му"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "Запазеният токен не може да бъде декриптиран"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "Файлът с ключа за хранилището за токени липсва или е неизползваем"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "Файлът с токена липсва или не е защитен"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "Криптираното съхранение е недостъпно; конфигурирайте файла с ключа или използвайте файл с токен"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "Въведете 32-знаковото шестнадесетично ID на Cloudflare акаунта"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "Въведете име от 1 до 100 знака без контролни знаци"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "Изберете криптиран токен или файл с токен"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "Въведете API токен"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "Въведете токена отново при промяна на ID на акаунта"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "Въведете абсолютен път с дължина най-много 255 знака"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "Трябва да бъде 0 или 1"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "Въведете цяло число секунди от 60 до 86400"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "Това ID на Cloudflare акаунт вече е конфигурирано"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Глобални API ключове (Global API Keys) не се приемат; използвайте API токен с ограничен обхват"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "Форматът на API токена е невалиден"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "Файлът с ключа за хранилището за токени липсва, не може да се чете, не е защитен или е с невалиден формат"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "Запазеният API токен не можа да бъде декриптиран"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "Файлът с токена липсва, не може да се чете, не е обикновен файл или е твърде голям"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Пътят до файла с токена не е абсолютен, представлява символна връзка или файлът е достъпен за четене или запис от всички потребители"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "Файлът с токена не се намира в „Директория за файлове с токени“"

#: includes/accounts.php
msgid "API token could not be encrypted"
msgstr "API токенът не можа да бъде криптиран"

#: includes/accounts.php
msgid "Credential error"
msgstr "Грешка в данните за достъп"

