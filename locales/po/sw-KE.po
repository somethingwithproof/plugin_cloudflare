msgstr[0] "Bofya 'Endelea' ili kufuta Akaunti ya Cloudflare ifuatayo. Orodha yake iliyogunduliwa na hali ya kazi huondolewa; vifaa na grafu za Cacti huhifadhiwa."
msgstr[1] "Bofya 'Endelea' ili kufuta Akaunti za Cloudflare zifuatazo. Orodha zake zilizogunduliwa na hali ya kazi huondolewa; vifaa na grafu za Cacti huhifadhiwa."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Bofya 'Endelea' ili kuthibitisha Akaunti ya Cloudflare ifuatayo dhidi ya API ya Cloudflare."
msgstr[1] "Bofya 'Endelea' ili kuthibitisha Akaunti za Cloudflare zifuatazo dhidi ya API ya Cloudflare."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Bofya 'Endelea' ili kuwasha Akaunti ya Cloudflare ifuatayo."
msgstr[1] "Bofya 'Endelea' ili kuwasha Akaunti za Cloudflare zifuatazo."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Bofya 'Endelea' ili kuzima Akaunti ya Cloudflare ifuatayo."
msgstr[1] "Bofya 'Endelea' ili kuzima Akaunti za Cloudflare zifuatazo."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Bofya 'Endelea' ili kuunda kifaa cha Cacti kwa Akaunti ya Cloudflare ifuatayo. Akaunti ambayo tayari ina kifaa huachwa ilivyo."
msgstr[1] "Bofya 'Endelea' ili kuunda kifaa cha Cacti kwa kila moja ya Akaunti za Cloudflare zifuatazo. Akaunti ambayo tayari ina kifaa huachwa ilivyo."

