#: cloudflare_operator.php
msgid "Monitoring view"
msgstr "Προβολή παρακολούθησης"

#: cloudflare_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Δεν ήταν δυνατή η ανάγνωση των παρατηρήσεων. Ζητήστε από έναν διαχειριστή να ελέγξει το αρχείο καταγραφής του πρόσθετου."

#: includes/accounts.php
msgid "Connection verified"
msgstr "Η σύνδεση επαληθεύτηκε"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "Το διακριτικό δεν είναι ενεργό. Ενδέχεται να έχει λήξει ή να έχει απενεργοποιηθεί"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "Το διακριτικό δεν είναι έγκυρο ή έχει λήξει"

#: includes/accounts.php
msgid "Token lacks the Account Cloudflare Tunnel Read permission"
msgstr "Το διακριτικό δεν διαθέτει το δικαίωμα Account Cloudflare Tunnel Read"

#: includes/accounts.php
msgid "Cloudflare API is unreachable; try again later"
msgstr "Το Cloudflare API δεν είναι προσβάσιμο. Δοκιμάστε ξανά αργότερα"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Συμπληρώθηκε το όριο ρυθμού του Cloudflare API. Δοκιμάστε ξανά αργότερα"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Το αίτημα προς το Cloudflare API απέτυχε απροσδόκητα"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "Το διακριτικό δεν διαθέτει τα απαραίτητα δικαιώματα για την επαλήθευσή του"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "Δεν είναι δυνατή η αποκρυπτογράφηση του αποθηκευμένου διακριτικού"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "Το αρχείο κλειδιού θησαυροφυλακίου διακριτικών λείπει ή δεν μπορεί να χρησιμοποιηθεί"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "Το αρχείο διακριτικού λείπει ή δεν είναι ασφαλές"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "Η κρυπτογραφημένη αποθήκευση δεν είναι διαθέσιμη. Ρυθμίστε το αρχείο κλειδιού ή χρησιμοποιήστε αρχείο διακριτικού"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "Εισαγάγετε το δεκαεξαδικό αναγνωριστικό λογαριασμού Cloudflare των 32 χαρακτήρων"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "Εισαγάγετε ένα όνομα από 1 έως 100 χαρακτήρες χωρίς χαρακτήρες ελέγχου"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "Επιλέξτε κρυπτογραφημένο διακριτικό ή αρχείο διακριτικού"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "Εισαγάγετε ένα διακριτικό API"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "Εισαγάγετε ξανά το διακριτικό όταν αλλάζετε το αναγνωριστικό λογαριασμού"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "Εισαγάγετε μια απόλυτη διαδρομή έως 255 χαρακτήρων"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "Πρέπει να είναι 0 ή 1"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "Εισαγάγετε έναν ακέραιο αριθμό δευτερολέπτων από 60 έως 86400"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "Αυτό το αναγνωριστικό λογαριασμού Cloudflare έχει ήδη ρυθμιστεί"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Τα Καθολικά κλειδιά API (Global API Keys) δεν γίνονται δεκτά. Χρησιμοποιήστε ένα διακριτικό API περιορισμένου εύρους"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "Η μορφή του διακριτικού API δεν είναι έγκυρη"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "Το αρχείο κλειδιού θησαυροφυλακίου διακριτικών λείπει, δεν είναι αναγνώσιμο, δεν είναι ασφαλές ή έχει κακή μορφή"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "Δεν ήταν δυνατή η αποκρυπτογράφηση του αποθηκευμένου διακριτικού API"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "Το αρχείο διακριτικού λείπει, δεν είναι αναγνώσιμο, δεν είναι κανονικό αρχείο ή είναι πολύ μεγάλο"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Η διαδρομή του αρχείου διακριτικού δεν είναι απόλυτη, είναι συμβολικός σύνδεσμος ή το αρχείο είναι αναγνώσιμο ή εγγράψιμο από όλους"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "Το αρχείο διακριτικού δεν βρίσκεται μέσα στον Κατάλογο αρχείων διακριτικών"

#: includes/accounts.php
msgid "API token could not be encrypted"
msgstr "Δεν ήταν δυνατή η κρυπτογράφηση του διακριτικού API"

#: includes/accounts.php
msgid "Credential error"
msgstr "Σφάλμα διαπιστευτηρίων"

