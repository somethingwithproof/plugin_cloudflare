msgid "You are not permitted to create Cacti devices."
msgstr "Nie masz uprawnień do tworzenia urządzeń Cacti."

#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Kliknij 'Kontynuuj', aby usunąć następujące konto Cloudflare. Wykryte zasoby i stan zadań zostaną usunięte; urządzenia i wykresy Cacti zostaną zachowane."
msgstr[1] "Kliknij 'Kontynuuj', aby usunąć następujące konta Cloudflare. Wykryte zasoby i stan zadań zostaną usunięte; urządzenia i wykresy Cacti zostaną zachowane."
msgstr[2] "Kliknij 'Kontynuuj', aby usunąć następujące konta Cloudflare. Wykryte zasoby i stan zadań zostaną usunięte; urządzenia i wykresy Cacti zostaną zachowane."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Kliknij 'Kontynuuj', aby zweryfikować następujące konto Cloudflare za pomocą interfejsu Cloudflare API."
msgstr[1] "Kliknij 'Kontynuuj', aby zweryfikować następujące konta Cloudflare za pomocą interfejsu Cloudflare API."
msgstr[2] "Kliknij 'Kontynuuj', aby zweryfikować następujące konta Cloudflare za pomocą interfejsu Cloudflare API."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Kliknij 'Kontynuuj', aby włączyć następujące konto Cloudflare."
msgstr[1] "Kliknij 'Kontynuuj', aby włączyć następujące konta Cloudflare."
msgstr[2] "Kliknij 'Kontynuuj', aby włączyć następujące konta Cloudflare."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Kliknij 'Kontynuuj', aby wyłączyć następujące konto Cloudflare."
msgstr[1] "Kliknij 'Kontynuuj', aby wyłączyć następujące konta Cloudflare."
msgstr[2] "Kliknij 'Kontynuuj', aby wyłączyć następujące konta Cloudflare."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Kliknij 'Kontynuuj', aby utworzyć urządzenie Cacti dla następującego konta Cloudflare. Konto, które już je posiada, pozostaje bez zmian."
msgstr[1] "Kliknij 'Kontynuuj', aby utworzyć urządzenie Cacti dla każdego z następujących kont Cloudflare. Konto, które już je posiada, pozostaje bez zmian."
msgstr[2] "Kliknij 'Kontynuuj', aby utworzyć urządzenie Cacti dla każdego z następujących kont Cloudflare. Konto, które już je posiada, pozostaje bez zmian."

