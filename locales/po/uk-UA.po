msgstr "Загальний час у секундах, дозволений для запиту до API Cloudflare, виконаного з вебінтерфейсу, наприклад під час верифікації."

#: includes/settings.php
msgid "Collector Request Timeout"
msgstr "Тайм-аут запиту збирача"

#: includes/settings.php
msgid "Total time in seconds allowed for a Cloudflare API request made by the background collector."
