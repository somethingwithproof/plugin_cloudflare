msgstr[1] "Klicka på 'Fortsätt' för att ta bort följande Cloudflare-konton. Deras upptäckta inventering och jobbstatus tas bort; Cacti-enheter och grafer behålls."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Klicka på 'Fortsätt' för att verifiera följande Cloudflare-konto mot Cloudflare API."
msgstr[1] "Klicka på 'Fortsätt' för att verifiera följande Cloudflare-konton mot Cloudflare API."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Klicka på 'Fortsätt' för att aktivera följande Cloudflare-konto."
msgstr[1] "Klicka på 'Fortsätt' för att aktivera följande Cloudflare-konton."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Klicka på 'Fortsätt' för att inaktivera följande Cloudflare-konto."
msgstr[1] "Klicka på 'Fortsätt' för att inaktivera följande Cloudflare-konton."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Klicka på 'Fortsätt' för att skapa en Cacti-enhet för följande Cloudflare-konto. Ett konto som redan har en lämnas orört."
msgstr[1] "Klicka på 'Fortsätt' för att skapa en Cacti-enhet för vart och ett av följande Cloudflare-konton. Ett konto som redan har en lämnas orört."

