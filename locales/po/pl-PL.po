msgstr "Nie można odczytać obserwacji. Poproś administratora o sprawdzenie dziennika wtyczki."

#: includes/accounts.php
msgid "Connection verified"
msgstr "Połączenie zweryfikowane"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "Token nie jest aktywny; może być wygasły lub wyłączony"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "Token jest nieprawidłowy lub wygasł"

#: includes/accounts.php
msgid "Token lacks the Account Cloudflare Tunnel Read permission"
msgstr "Token nie ma uprawnienia Account Cloudflare Tunnel Read"

#: includes/accounts.php
msgid "Cloudflare API is unreachable; try again later"
msgstr "Interfejs API Cloudflare jest nieosiągalny; spróbuj ponownie później"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Osiągnięto limit żądań interfejsu API Cloudflare; spróbuj ponownie później"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Żądanie do interfejsu API Cloudflare nieoczekiwanie nie powiodło się"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "Token nie ma uprawnień wymaganych do jego weryfikacji"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "Nie można odszyfrować zapisanego tokenu"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "Brak pliku klucza sejfu tokenów lub nie można go użyć"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "Brak pliku tokenu lub plik jest niezabezpieczony"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "Zaszyfrowany magazyn jest niedostępny; skonfiguruj plik klucza lub użyj pliku tokenu"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "Wprowadź 32-znakowy szesnastkowy identyfikator konta Cloudflare"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "Wprowadź nazwę o długości od 1 do 100 znaków bez znaków sterujących"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "Wybierz zaszyfrowany token lub plik tokenu"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "Wprowadź token API"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "Wprowadź token ponownie przy zmianie identyfikatora konta"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "Wprowadź ścieżkę bezwzględną o długości co najwyżej 255 znaków"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "Musi wynosić 0 lub 1"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "Wprowadź całkowitą liczbę sekund od 60 do 86400"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "Ten identyfikator konta Cloudflare jest już skonfigurowany"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Globalne klucze API nie są akceptowane; użyj tokenu API o ograniczonym zakresie"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "Format tokenu API jest nieprawidłowy"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "Plik klucza sejfu tokenów nie istnieje, jest nieczytelny, niezabezpieczony lub uszkodzony"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "Nie udało się odszyfrować zapisanego tokenu API"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "Plik tokenu nie istnieje, jest nieczytelny, nie jest zwykłym plikiem lub jest zbyt duży"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Ścieżka pliku tokenu nie jest bezwzględna, jest dowiązaniem symbolicznym albo plik jest dostępny do odczytu lub zapisu dla wszystkich użytkowników"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "Plik tokenu nie znajduje się w katalogu plików tokenów"

#: includes/accounts.php
msgid "API token could not be encrypted"
msgstr "Nie udało się zaszyfrować tokenu API"

#: includes/accounts.php
msgid "Credential error"
msgstr "Błąd poświadczeń"

