msgstr[2] "Noklikšķiniet uz \"Turpināt\", lai dzēstu tālāk norādītos Cloudflare kontus. To atklātais inventārs un uzdevumu stāvoklis tiks noņemts; Cacti ierīces un grafiki tiks saglabāti."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Noklikšķiniet uz \"Turpināt\", lai pārbaudītu tālāk norādītos Cloudflare kontus, izmantojot Cloudflare API."
msgstr[1] "Noklikšķiniet uz \"Turpināt\", lai pārbaudītu tālāk norādīto Cloudflare kontu, izmantojot Cloudflare API."
msgstr[2] "Noklikšķiniet uz \"Turpināt\", lai pārbaudītu tālāk norādītos Cloudflare kontus, izmantojot Cloudflare API."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Noklikšķiniet uz \"Turpināt\", lai iespējotu tālāk norādītos Cloudflare kontus."
msgstr[1] "Noklikšķiniet uz \"Turpināt\", lai iespējotu tālāk norādīto Cloudflare kontu."
