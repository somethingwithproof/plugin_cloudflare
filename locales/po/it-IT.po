#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Fare clic su 'Continua' per eliminare il seguente account Cloudflare. L'inventario rilevato e lo stato dei processi vengono rimossi; i dispositivi e i grafici Cacti vengono mantenuti."
msgstr[1] "Fare clic su 'Continua' per eliminare i seguenti account Cloudflare. L'inventario rilevato e lo stato dei processi vengono rimossi; i dispositivi e i grafici Cacti vengono mantenuti."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Fare clic su 'Continua' per verificare il seguente account Cloudflare tramite l'API di Cloudflare."
msgstr[1] "Fare clic su 'Continua' per verificare i seguenti account Cloudflare tramite l'API di Cloudflare."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Fare clic su 'Continua' per abilitare il seguente account Cloudflare."
msgstr[1] "Fare clic su 'Continua' per abilitare i seguenti account Cloudflare."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Fare clic su 'Continua' per disabilitare il seguente account Cloudflare."
msgstr[1] "Fare clic su 'Continua' per disabilitare i seguenti account Cloudflare."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Fare clic su 'Continua' per creare un dispositivo Cacti per il seguente account Cloudflare. Un account che ne possiede già uno viene lasciato invariato."
msgstr[1] "Fare clic su 'Continua' per creare un dispositivo Cacti per ciascuno dei seguenti account Cloudflare. Un account che ne possiede già uno viene lasciato invariato."

