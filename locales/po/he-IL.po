#: includes/settings.php
msgid "Absolute path to the 32-byte key used to encrypt stored API tokens. It must be readable by the web server and poller users and not world-readable. When the file is missing, only token files can be used."
msgstr "נתיב מוחלט למפתח בן 32 בתים המשמש להצפנת אסימוני API שמורים. הקובץ חייב להיות קריא עבור משתמשי שרת האינטרנט והדוגם, ולא פתוח לקריאה לכל המשתמשים. כאשר הקובץ חסר, ניתן להשתמש בקובצי אסימונים בלבד."

#: includes/settings.php
msgid "Token File Directory"
msgstr "תיקיית קובצי אסימונים"

#: includes/settings.php
msgid "Absolute path of the directory that every account token file must be in. When empty, a token file may be anywhere the web server and poller users can read."
msgstr "הנתיב המוחלט של התיקייה שבה חייב להימצא כל קובץ אסימון של חשבון. כאשר שדה זה ריק, קובץ אסימון יכול להימצא בכל מקום שמשתמשי שרת האינטרנט והדוגם יכולים לקרוא ממנו."

#: includes/settings.php
msgid "Interactive Request Timeout"
msgstr "פסק זמן לבקשה אינטראקטיבית"

#: includes/settings.php
msgid "Total time in seconds allowed for a Cloudflare API request made from the web interface, such as Verify."
msgstr "הזמן הכולל בשניות המותר לבקשת Cloudflare API הנשלחת מממשק האינטרנט, כגון אימות."

#: includes/settings.php
msgid "Collector Request Timeout"
msgstr "פסק זמן לבקשת אוסף הנתונים"

#: includes/settings.php
msgid "Total time in seconds allowed for a Cloudflare API request made by the background collector."
msgstr "הזמן הכולל בשניות המותר לבקשת Cloudflare API הנשלחת על ידי אוסף הנתונים ברקע."

#: includes/settings.php
msgid "Log Level"
msgstr "רמת יומן"

#: includes/settings.php
msgid "The amount of detail the plugin writes to the Cacti log."
msgstr "רמת הפירוט שהתוסף כותב ליומן Cacti."

#: includes/tunnel_retirement.php
msgid "The tunnel could not be retired. Check permissions and retry after collection finishes."
msgstr "לא ניתן להוציא את המנהרה משימוש. בדוק את ההרשאות ונסה שוב לאחר סיום האיסוף."

#: includes/tunnel_retirement.php includes/viewer.php
msgid "Retire tunnel"
msgstr "הוצאת מנהרה משימוש"

#: includes/tunnel_retirement.php
msgid "Retiring removes the graphs and unshared data sources created for this deleted tunnel. Cacti controls RRD cleanup. The inventory record is kept."
msgstr "הוצאה משימוש מסירה את הגרפים ואת מקורות הנתונים הלא משותפים שנוצרו עבור מנהרה שנמחקה זו. Cacti שולט בניקוי קובצי RRD. רשומת המלאי נשמרת."

#: includes/viewer.php
msgid "The Cloudflare tunnels could not be read. See the Cacti log for details."
msgstr "לא ניתן לקרוא את מנהרות ה-Cloudflare. עיין ביומן Cacti לפרטים."

