#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Cliquez sur 'Continuer' pour supprimer le compte Cloudflare suivant. Son inventaire découvert et l'état de ses tâches sont supprimés ; les équipements et graphiques Cacti sont conservés."
msgstr[1] "Cliquez sur 'Continuer' pour supprimer les comptes Cloudflare suivants. Leur inventaire découvert et l'état de leurs tâches sont supprimés ; les équipements et graphiques Cacti sont conservés."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Cliquez sur 'Continuer' pour vérifier le compte Cloudflare suivant auprès de l'API Cloudflare."
msgstr[1] "Cliquez sur 'Continuer' pour vérifier les comptes Cloudflare suivants auprès de l'API Cloudflare."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Cliquez sur 'Continuer' pour activer le compte Cloudflare suivant."
msgstr[1] "Cliquez sur 'Continuer' pour activer les comptes Cloudflare suivants."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Cliquez sur 'Continuer' pour désactiver le compte Cloudflare suivant."
msgstr[1] "Cliquez sur 'Continuer' pour désactiver les comptes Cloudflare suivants."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Cliquez sur 'Continuer' pour créer un équipement Cacti pour le compte Cloudflare suivant. Un compte qui en a déjà un reste inchangé."
msgstr[1] "Cliquez sur 'Continuer' pour créer un équipement Cacti pour chacun des comptes Cloudflare suivants. Un compte qui en a déjà un reste inchangé."

