#: cloudflare_operator.php
msgid "Monitoring view"
msgstr "निरीक्षण दृश्य"

#: cloudflare_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "निरीक्षणे वाचता आली नाहीत. प्रशासकाला प्लगइन लॉग तपासण्यास सांगा."

#: includes/accounts.php
msgid "Connection verified"
msgstr "कनेक्शन सत्यापित झाले"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "टोकन सक्रिय नाही; ते कालबाह्य किंवा अक्षम असू शकते"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "टोकन अवैध किंवा कालबाह्य आहे"

#: includes/accounts.php
msgid "Token lacks the Account Cloudflare Tunnel Read permission"
msgstr "टोकनकडे Account Cloudflare Tunnel Read परवानगी नाही"

#: includes/accounts.php
msgid "Cloudflare API is unreachable; try again later"
msgstr "Cloudflare API पर्यंत पोहोचता येत नाही; नंतर पुन्हा प्रयत्न करा"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Cloudflare API दर मर्यादा गाठली आहे; नंतर पुन्हा प्रयत्न करा"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Cloudflare API विनंती अनपेक्षितपणे अयशस्वी झाली"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "टोकन सत्यापित करण्यासाठी आवश्यक परवानग्या टोकनकडे नाहीत"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "साठवलेले टोकन डिक्रिप्ट करता येत नाही"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "टोकन व्हॉल्ट की फाइल गहाळ आहे किंवा वापरण्यायोग्य नाही"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "टोकन फाइल गहाळ आहे किंवा असुरक्षित आहे"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "एनक्रिप्ट केलेले स्टोरेज अनुपलब्ध आहे; की फाइल कॉन्फिगर करा किंवा टोकन फाइल वापरा"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "32-वर्णांचा हेक्साडेसिमल Cloudflare खाते ID प्रविष्ट करा"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "नियंत्रण वर्णाशिवाय 1 ते 100 वर्णांचे नाव प्रविष्ट करा"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "एनक्रिप्ट केलेले टोकन किंवा टोकन फाइल निवडा"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "API टोकन प्रविष्ट करा"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "खाते ID बदलताना टोकन पुन्हा प्रविष्ट करा"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "कमाल 255 वर्णांचा पूर्ण मार्ग प्रविष्ट करा"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "0 किंवा 1 असणे आवश्यक आहे"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "60 ते 86400 मधील पूर्णांक सेकंद प्रविष्ट करा"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "हा Cloudflare खाते ID आधीच कॉन्फिगर केलेला आहे"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Global API Keys स्वीकारल्या जात नाहीत; स्कोप केलेले API टोकन वापरा"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "API टोकन स्वरूप अवैध आहे"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "टोकन व्हॉल्ट की फाइल गहाळ, वाचता न येण्याजोगी, असुरक्षित किंवा सदोष आहे"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "संग्रहित API टोकन डिक्रिप्ट करता आले नाही"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "टोकन फाइल गहाळ आहे, वाचता येत नाही, नियमित फाइल नाही किंवा खूप मोठी आहे"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "टोकन फाइल मार्ग निरपेक्ष नाही, सिमलिंक आहे किंवा फाइल सर्वांना वाचण्याजोगी किंवा लिहिण्याजोगी आहे"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "टोकन फाइल 'टोकन फाइल निर्देशिका' मध्ये नाही"

#: includes/accounts.php
msgid "API token could not be encrypted"
msgstr "API टोकन एनक्रिप्ट करता आले नाही"

#: includes/accounts.php
msgid "Credential error"
msgstr "ओळखपत्र त्रुटी"

