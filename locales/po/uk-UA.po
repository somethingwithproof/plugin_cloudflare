#: cloudflare_operator.php
msgid "Monitoring view"
msgstr "Перегляд моніторингу"

#: cloudflare_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Не вдалося прочитати спостереження. Попросіть адміністратора перевірити журнал плагіна."

#: includes/accounts.php
msgid "Connection verified"
msgstr "З'єднання перевірено"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "Токен неактивний; можливо, термін його дії минув або його вимкнено"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "Токен недійсний або термін його дії минув"

#: includes/accounts.php
msgid "Token lacks the Account Cloudflare Tunnel Read permission"
msgstr "Токену бракує дозволу Account Cloudflare Tunnel Read"

#: includes/accounts.php
msgid "Cloudflare API is unreachable; try again later"
msgstr "API Cloudflare недоступний; спробуйте пізніше"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Досягнуто ліміт запитів API Cloudflare; спробуйте пізніше"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Запит до API Cloudflare несподівано завершився помилкою"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "Токену бракує дозволів, необхідних для його перевірки"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "Неможливо розшифрувати збережений токен"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "Файл ключа сховища токенів відсутній або непридатний до використання"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "Файл токена відсутній або небезпечний"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "Зашифроване сховище недоступне; налаштуйте файл ключа або використайте файл токена"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "Введіть 32-символьний шістнадцятковий ідентифікатор облікового запису Cloudflare"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "Введіть назву завдовжки від 1 до 100 символів без керівних символів"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "Виберіть зашифрований токен або файл токена"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "Введіть токен API"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "Повторно введіть токен у разі зміни ідентифікатора облікового запису"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "Введіть абсолютний шлях завдовжки щонайбільше 255 символів"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "Має бути 0 або 1"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "Введіть ціле число секунд від 60 до 86400"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "Цей ідентифікатор облікового запису Cloudflare вже налаштовано"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Глобальні ключі API не приймаються; використовуйте обмежений токен API"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "Недійсний формат токена API"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "Файл ключа сховища токенів відсутній, недоступний для читання, небезпечний або пошкоджений"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "Не вдалося розшифрувати збережений токен API"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "Файл токена відсутній, недоступний для читання, не є звичайним файлом або занадто великий"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Шлях до файлу токена не є абсолютним, є символічним посиланням, або файл доступний для читання чи запису всім користувачам"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "Файл токена не знаходиться в каталозі файлів токенів"

#: includes/accounts.php
msgid "API token could not be encrypted"
msgstr "Не вдалося зашифрувати токен API"

#: includes/accounts.php
msgid "Credential error"
msgstr "Помилка облікових даних"

