#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "সর্বোচ্চ ২৫৫টি অক্ষরের একটি সম্পূর্ণ পাথ লিখুন"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "০ অথবা ১ হতে হবে"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "৬০ থেকে ৮৬৪০০-এর মধ্যে পূর্ণ সংখ্যায় সেকেন্ড লিখুন"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "এই Cloudflare অ্যাকাউন্ট ID ইতিমধ্যেই কনফিগার করা হয়েছে"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "গ্লোবাল API কী গ্রহণযোগ্য নয়; একটি স্কোপড API টোকেন ব্যবহার করুন"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "API টোকেনের ফরম্যাট অবৈধ"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "টোকেন ভল্ট কী ফাইলটি অনুপস্থিত, অপঠনযোগ্য, অনিরাপদ বা ত্রুটিপূর্ণ"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "সংরক্ষিত API টোকেন ডিক্রিপ্ট করা যায়নি"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "টোকেন ফাইলটি অনুপস্থিত, অপঠনযোগ্য, সাধারণ ফাইল নয় অথবা আকারে অনেক বড়"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "টোকেন ফাইলের পাথটি অ্যাবসোলিউট নয়, এটি একটি সিমলিংক, অথবা ফাইলটি সবার জন্য পঠনযোগ্য বা লিখনযোগ্য"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "টোকেন ফাইলটি টোকেন ফাইল ডিরেক্টরির ভেতরে নেই"

