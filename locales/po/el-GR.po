msgid "Cloudflare"
msgstr "Cloudflare"

#: includes/accounts.php
msgid "Encrypted in the Cacti database"
msgstr "Κρυπτογραφημένο στη βάση δεδομένων του Cacti"

#: includes/accounts.php
