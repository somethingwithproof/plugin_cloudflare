#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Klik op 'Doorgaan' om het volgende Cloudflare-account te verwijderen. De gedetecteerde inventaris en taakstatus worden verwijderd; Cacti-apparaten en -grafieken blijven behouden."
msgstr[1] "Klik op 'Doorgaan' om de volgende Cloudflare-accounts te verwijderen. De gedetecteerde inventaris en taakstatus worden verwijderd; Cacti-apparaten en -grafieken blijven behouden."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Klik op 'Doorgaan' om het volgende Cloudflare-account te verifiëren via de Cloudflare API."
msgstr[1] "Klik op 'Doorgaan' om de volgende Cloudflare-accounts te verifiëren via de Cloudflare API."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Klik op 'Doorgaan' om het volgende Cloudflare-account in te schakelen."
msgstr[1] "Klik op 'Doorgaan' om de volgende Cloudflare-accounts in te schakelen."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Klik op 'Doorgaan' om het volgende Cloudflare-account uit te schakelen."
msgstr[1] "Klik op 'Doorgaan' om de volgende Cloudflare-accounts uit te schakelen."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Klik op 'Doorgaan' om een Cacti-apparaat te maken voor het volgende Cloudflare-account. Een account dat er al een heeft, blijft ongewijzigd."
msgstr[1] "Klik op 'Doorgaan' om voor elk van de volgende Cloudflare-accounts een Cacti-apparaat te maken. Een account dat er al een heeft, blijft ongewijzigd."

