msgid "Must be 0 or 1"
msgstr "Igomba kuba 0 cyangwa 1"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "Injiza umubare wuzuye w'amasegonda kuva kuri 60 kugeza kuri 86400"

