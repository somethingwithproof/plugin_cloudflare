#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Кликните на 'Настави' да обришете следећи Cloudflare налог. Његов откривени инвентар и стање задатака биће уклоњени; Cacti уређаји и графикони се задржавају."
msgstr[1] "Кликните на 'Настави' да обришете следеће Cloudflare налоге. Њихов откривени инвентар и стање задатака биће уклоњени; Cacti уређаји и графикони се задржавају."
msgstr[2] "Кликните на 'Настави' да обришете следеће Cloudflare налоге. Њихов откривени инвентар и стање задатака биће уклоњени; Cacti уређаји и графикони се задржавају."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Кликните на 'Настави' да проверите следећи Cloudflare налог преко Cloudflare API-ја."
msgstr[1] "Кликните на 'Настави' да проверите следеће Cloudflare налоге преко Cloudflare API-ја."
msgstr[2] "Кликните на 'Настави' да проверите следеће Cloudflare налоге преко Cloudflare API-ја."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Кликните на 'Настави' да омогућите следећи Cloudflare налог."
msgstr[1] "Кликните на 'Настави' да омогућите следеће Cloudflare налоге."
msgstr[2] "Кликните на 'Настави' да омогућите следеће Cloudflare налоге."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Кликните на 'Настави' да онемогућите следећи Cloudflare налог."
msgstr[1] "Кликните на 'Настави' да онемогућите следеће Cloudflare налоге."
msgstr[2] "Кликните на 'Настави' да онемогућите следеће Cloudflare налоге."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Кликните на 'Настави' да креирате Cacti уређај за следећи Cloudflare налог. Налог који га већ има остаје непромењен."
msgstr[1] "Кликните на 'Настави' да креирате Cacti уређај за сваки од следећих Cloudflare налога. Налог који га већ има остаје непромењен."
msgstr[2] "Кликните на 'Настави' да креирате Cacti уређај за сваки од следећих Cloudflare налога. Налог који га већ има остаје непромењен."

