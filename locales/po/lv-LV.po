#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Noklikšķiniet uz \"Turpināt\", lai atspējotu tālāk norādītos Cloudflare kontus."
msgstr[1] "Noklikšķiniet uz \"Turpināt\", lai atspējotu tālāk norādīto Cloudflare kontu."
msgstr[2] "Noklikšķiniet uz \"Turpināt\", lai atspējotu tālāk norādītos Cloudflare kontus."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Noklikšķiniet uz \"Turpināt\", lai izveidotu Cacti ierīci katram no tālāk norādītajiem Cloudflare kontiem. Konts, kuram ierīce jau ir, netiks mainīts."
msgstr[1] "Noklikšķiniet uz \"Turpināt\", lai izveidotu Cacti ierīci tālāk norādītajam Cloudflare kontam. Konts, kuram ierīce jau ir, netiks mainīts."
msgstr[2] "Noklikšķiniet uz \"Turpināt\", lai izveidotu Cacti ierīci katram no tālāk norādītajiem Cloudflare kontiem. Konts, kuram ierīce jau ir, netiks mainīts."

