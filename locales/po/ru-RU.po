#: cloudflare_operator.php
msgid "Monitoring view"
msgstr "Представление мониторинга"

#: cloudflare_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Не удалось прочитать наблюдения. Попросите администратора проверить журнал плагина."

#: includes/accounts.php
msgid "Connection verified"
msgstr "Подключение проверено"

#: includes/accounts.php
msgid "Token is not active; it may be expired or disabled"
msgstr "Токен неактивен; возможно, срок его действия истёк или он отключён"

#: includes/accounts.php
msgid "Token is invalid or expired"
msgstr "Токен недействителен или срок его действия истёк"

#: includes/accounts.php
msgid "Token lacks the Account Cloudflare Tunnel Read permission"
msgstr "У токена отсутствует разрешение Account Cloudflare Tunnel Read"

#: includes/accounts.php
msgid "Cloudflare API is unreachable; try again later"
msgstr "API Cloudflare недоступен; повторите попытку позже"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Достигнут предел частоты запросов API Cloudflare; повторите попытку позже"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Непредвиденный сбой запроса к API Cloudflare"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "У токена недостаточно разрешений для его проверки"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "Не удалось расшифровать сохранённый токен"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "Файл ключа хранилища токенов отсутствует или непригоден для использования"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "Файл токена отсутствует или небезопасен"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "Зашифрованное хранилище недоступно; настройте файл ключа или используйте файл токена"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "Введите 32-символьный шестнадцатеричный ID учётной записи Cloudflare"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "Введите имя длиной от 1 до 100 символов без управляющих символов"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "Выберите зашифрованный токен или файл токена"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "Введите токен API"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "Повторно введите токен при изменении ID учётной записи"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "Введите абсолютный путь длиной не более 255 символов"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "Должно быть 0 или 1"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "Введите целое число секунд от 60 до 86400"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "Этот ID учётной записи Cloudflare уже настроен"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Глобальные ключи API не принимаются; используйте токен API с ограниченными правами"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "Недопустимый формат токена API"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "Файл ключа хранилища токенов отсутствует, недоступен для чтения, небезопасен или имеет неверный формат"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "Не удалось расшифровать сохранённый токен API"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "Файл токена отсутствует, недоступен для чтения, не является обычным файлом или слишком велик"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "Путь к файлу токена не является абсолютным, является символьной ссылкой, либо файл доступен для чтения или записи всем пользователям"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "Файл токена не находится в каталоге файлов токенов"

#: includes/accounts.php
msgid "API token could not be encrypted"
msgstr "Не удалось зашифровать токен API"

#: includes/accounts.php
msgid "Credential error"
msgstr "Ошибка учётных данных"

