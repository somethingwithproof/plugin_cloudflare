msgid "Cloudflare API is unreachable; try again later"
msgstr "Cloudflare API तक पहुँचा नहीं जा सकता; बाद में फिर प्रयास करें"

#: includes/accounts.php
msgid "Cloudflare API rate limit reached; try again later"
msgstr "Cloudflare API की दर सीमा तक पहुँच गए; बाद में फिर प्रयास करें"

#: includes/accounts.php
msgid "Cloudflare API request failed unexpectedly"
msgstr "Cloudflare API अनुरोध अप्रत्याशित रूप से विफल हुआ"

#: includes/accounts.php
msgid "Token lacks the permissions needed to verify it"
msgstr "टोकन के पास उसके सत्यापन के लिए आवश्यक अनुमतियाँ नहीं हैं"

#: includes/accounts.php
msgid "Stored token cannot be decrypted"
msgstr "संग्रहीत टोकन डिक्रिप्ट नहीं किया जा सकता"

#: includes/accounts.php
msgid "Token vault key file is missing or unusable"
msgstr "टोकन वॉल्ट कुंजी फ़ाइल अनुपस्थित या अनुपयोगी है"

#: includes/accounts.php
msgid "Token file is missing or insecure"
msgstr "टोकन फ़ाइल अनुपस्थित या असुरक्षित है"

#: includes/accounts.php
msgid "Encrypted storage is unavailable; configure the key file or use a token file"
msgstr "एन्क्रिप्टेड संग्रह उपलब्ध नहीं है; कुंजी फ़ाइल कॉन्फ़िगर करें या टोकन फ़ाइल उपयोग करें"

#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "32-वर्णों वाला हेक्साडेसिमल Cloudflare खाता ID दर्ज करें"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "नियंत्रण वर्णों के बिना 1 से 100 वर्णों का नाम दर्ज करें"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "एन्क्रिप्टेड टोकन या टोकन फ़ाइल चुनें"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "API टोकन दर्ज करें"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "खाता ID बदलते समय टोकन फिर दर्ज करें"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "अधिकतम 255 वर्णों का पूर्ण पथ दर्ज करें"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "0 या 1 होना चाहिए"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "60 से 86400 तक पूर्ण सेकंड दर्ज करें"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "यह Cloudflare खाता ID पहले से कॉन्फ़िगर है"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
msgstr "Global API Keys स्वीकार नहीं की जातीं; सीमित दायरे वाला API टोकन उपयोग करें"

#: includes/accounts.php
msgid "API token format is invalid"
msgstr "API टोकन का प्रारूप अमान्य है"

#: includes/accounts.php
msgid "Token vault key file is missing, unreadable, insecure or malformed"
msgstr "टोकन वॉल्ट कुंजी फ़ाइल अनुपस्थित, अपठनीय, असुरक्षित या गलत प्रारूप में है"

#: includes/accounts.php
msgid "Stored API token could not be decrypted"
msgstr "संग्रहीत API टोकन डिक्रिप्ट नहीं किया जा सका"

#: includes/accounts.php
msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "टोकन फ़ाइल अनुपस्थित, अपठनीय, सामान्य फ़ाइल नहीं या बहुत बड़ी है"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "टोकन फ़ाइल का पथ पूर्ण नहीं है, सिमलिंक है, या फ़ाइल सभी उपयोगकर्ताओं के पढ़ने या लिखने योग्य है"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "टोकन फ़ाइल टोकन फ़ाइल डायरेक्टरी के भीतर नहीं है"

