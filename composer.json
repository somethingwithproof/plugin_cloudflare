{
	"name": "cacti/plugin-cloudflare",
	"description": "Read-only Cloudflare Tunnel and analytics monitoring for Cacti",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"config": {
		"audit": {
			"abandoned": "report"
		},
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true
	},
	"autoload": {
		"psr-4": {
			"Cacti\\PluginCloudflare\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Cacti\\PluginCloudflare\\Tests\\": "tests/",
			"Cacti\\PluginCloudflare\\Features\\": "features/bootstrap/"
		}
	},
	"require-dev": {
		"behat/behat": "^3.15",
		"friendsofphp/php-cs-fixer": "^3.95",
		"giorgiosironi/eris": "^0.14",
		"phpstan/phpstan": "^1.12",
		"phpunit/phpunit": "^9.6"
	}
}
