#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "הזן נתיב מוחלט באורך של עד 255 תווים"

#: includes/accounts.php
msgid "Must be 0 or 1"
msgstr "חייב להיות 0 או 1"

#: includes/accounts.php
msgid "Enter a whole number of seconds from 60 to 86400"
msgstr "הזן מספר שלם של שניות בין 60 ל-86400"

#: includes/accounts.php
msgid "This Cloudflare account ID is already configured"
msgstr "מזהה חשבון Cloudflare זה כבר מוגדר"

#: includes/accounts.php
msgid "Global API Keys are not accepted; use a scoped API token"
