msgid "Token file is missing, unreadable, not a regular file or too large"
msgstr "토큰 파일이 없거나, 읽을 수 없거나, 일반 파일이 아니거나, 너무 큽니다"

#: includes/accounts.php
msgid "Token file path is not absolute, is a symlink, or the file is world-readable or world-writable"
msgstr "토큰 파일 경로가 절대 경로가 아니거나, 심볼릭 링크이거나, 파일이 모든 사용자에게 읽기 또는 쓰기 가능으로 설정되어 있습니다"

#: includes/accounts.php
msgid "Token file is not inside the Token File Directory"
msgstr "토큰 파일이 토큰 파일 디렉터리 안에 있지 않습니다"

