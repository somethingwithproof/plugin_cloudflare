#: includes/accounts.php
msgid "Enter the 32-character hexadecimal Cloudflare account ID"
msgstr "Injiza ID ya konti ya Cloudflare y'inyuguti n'imibare 32 ya hexadecimal"

#: includes/accounts.php
msgid "Enter a name of 1 to 100 characters without control characters"
msgstr "Injiza izina ry'inyuguti kuva kuri 1 kugeza ku 100 nta nyuguti z'igenzura zirimo"

#: includes/accounts.php
msgid "Choose an encrypted token or a token file"
msgstr "Hitamo token yashyizwe mu ibanga cyangwa dosiye ya token"

#: includes/accounts.php
msgid "Enter an API token"
msgstr "Injiza API token"

#: includes/accounts.php
msgid "Re-enter the token when changing the account ID"
msgstr "Ongera winjize token igihe uhinduye ID ya konti"

#: includes/accounts.php
msgid "Enter an absolute path of at most 255 characters"
msgstr "Injiza inzira yuzuye itarengeje inyuguti 255"

