msgid "Create Graphs was left off: turning it on needs the permission to edit Cacti devices."
msgstr "„Diagramme erstellen“ blieb ausgeschaltet: Zum Einschalten ist die Berechtigung zum Bearbeiten von Cacti-Geräten erforderlich."

#: includes/accounts_page.php
msgid "Cacti device created"
msgstr "Cacti-Gerät erstellt"

#: includes/accounts_page.php
msgid "A Cacti device already exists for this account"
msgstr "Für dieses Konto existiert bereits ein Cacti-Gerät"

#: includes/accounts_page.php
msgid "The Cloudflare templates are not installed; see the Cacti log"
msgstr "Die Cloudflare-Vorlagen sind nicht installiert; siehe Cacti-Log"

#: includes/accounts_page.php
msgid "You are not permitted to create Cacti devices"
msgstr "Sie dürfen keine Cacti-Geräte erstellen"

#: includes/accounts_page.php
msgid "The Cacti device could not be created; see the Cacti log"
msgstr "Das Cacti-Gerät konnte nicht erstellt werden; siehe Cacti-Log"

#: includes/accounts_page.php
msgid "You are not permitted to create Cacti devices."
msgstr "Sie dürfen keine Cacti-Geräte erstellen."

#: includes/accounts_page.php
msgid "Click 'Continue' to Delete the following Cloudflare Account. Its discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgid_plural "Click 'Continue' to Delete the following Cloudflare Accounts. Their discovered inventory and job state are removed; Cacti devices and graphs are kept."
msgstr[0] "Klicken Sie auf „Fortsetzen“, um das folgende Cloudflare-Konto zu löschen. Der erkannte Bestand und der Auftragsstatus werden entfernt; Cacti-Geräte und Diagramme bleiben erhalten."
msgstr[1] "Klicken Sie auf „Fortsetzen“, um die folgenden Cloudflare-Konten zu löschen. Der erkannte Bestand und der Auftragsstatus werden entfernt; Cacti-Geräte und Diagramme bleiben erhalten."

#: includes/accounts_page.php
msgid "Click 'Continue' to Verify the following Cloudflare Account against the Cloudflare API."
msgid_plural "Click 'Continue' to Verify the following Cloudflare Accounts against the Cloudflare API."
msgstr[0] "Klicken Sie auf „Fortsetzen“, um das folgende Cloudflare-Konto über die Cloudflare-API zu überprüfen."
msgstr[1] "Klicken Sie auf „Fortsetzen“, um die folgenden Cloudflare-Konten über die Cloudflare-API zu überprüfen."

#: includes/accounts_page.php
msgid "Click 'Continue' to Enable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Enable the following Cloudflare Accounts."
msgstr[0] "Klicken Sie auf „Fortsetzen“, um das folgende Cloudflare-Konto zu aktivieren."
msgstr[1] "Klicken Sie auf „Fortsetzen“, um die folgenden Cloudflare-Konten zu aktivieren."

#: includes/accounts_page.php
msgid "Click 'Continue' to Disable the following Cloudflare Account."
msgid_plural "Click 'Continue' to Disable the following Cloudflare Accounts."
msgstr[0] "Klicken Sie auf „Fortsetzen“, um das folgende Cloudflare-Konto zu deaktivieren."
msgstr[1] "Klicken Sie auf „Fortsetzen“, um die folgenden Cloudflare-Konten zu deaktivieren."

#: includes/accounts_page.php
msgid "Click 'Continue' to create a Cacti device for the following Cloudflare Account. An account that already has one is left as it is."
msgid_plural "Click 'Continue' to create a Cacti device for each of the following Cloudflare Accounts. An account that already has one is left as it is."
msgstr[0] "Klicken Sie auf „Fortsetzen“, um ein Cacti-Gerät für das folgende Cloudflare-Konto zu erstellen. Ein Konto, das bereits eines hat, bleibt unverändert."
msgstr[1] "Klicken Sie auf „Fortsetzen“, um für jedes der folgenden Cloudflare-Konten ein Cacti-Gerät zu erstellen. Ein Konto, das bereits eines hat, bleibt unverändert."

